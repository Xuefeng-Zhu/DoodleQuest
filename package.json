{
  "name": "doodlequest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:web": "next dev --hostname 127.0.0.1",
    "worker": "tsx src/server/worker-entry.ts",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "start:production": "node --import tsx scripts/start-production.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "sample:generate": "tsx scripts/generate-sample.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "demo:record": "tsx scripts/record-demo.ts",
    "demo:reveal": "tsx scripts/record-reveal.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/fraunces": "5.3.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "dotenv": "18.0.5",
    "drizzle-orm": "0.45.3",
    "gltf-validator": "2.0.0-dev.3.10",
    "lucide-react": "1.49.0",
    "next": "16.3.8",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5",
    "three": "0.186.1",
    "workflow": "5.0.1",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "overrides": {
    "@workflow/core": {
      "devalue": "5.9.4",
      "nanoid": "5.1.16"
    }
  }
}
