# Single-node deployment; web and worker must share this persistent directory.
DATA_DIR=./data
APP_ORIGIN=http://localhost:3000
PORT=3000
# Leave empty for honest procedural example mode.
TRIPO_API_KEY=
# Documented H-series model as of 2026-09-30. Review docs before changing.
TRIPO_MODEL=v3.1-20260211
# Required to unlock paid generation, even during local live testing.
CREATOR_ACCESS_CODE=
# Whole-installation and per-session lifetime cap. Includes failed/uncertain attempts.
GENERATION_QUOTA=10
POLL_INTERVAL_MS=5000
# Exact provider output hosts only. Review a real task output before extending.
TRIPO_ASSET_HOSTS=cdn.tripo3d.ai
# Automated tests ONLY; production startup rejects this flag.
E2E_MOCK_PROVIDER=0
